{
  "name": "multiplicador-de-videos",
  "description": "Criação local de variações de vídeos curtos a partir de ganchos, desenvolvimentos e CTAs.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch-path=server server/index.js",
    "start:lan": "node server/index.js --lan",
    "start:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && node scripts/build-windows.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "dist:android": "npm run build && node scripts/build-android.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "latest",
    "archiver": "^8.0.0",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "latest",
    "multer": "^2.4.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "build": {
    "appId": "com.multiplica.videos",
    "productName": "Multiplica",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
